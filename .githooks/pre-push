#!/bin/sh
# pre-push — last-moment leak guard for a PUBLIC repo.
#
# pre-commit sees only STAGED files of a SINGLE commit. It is blind to
# --no-verify commits, commits predating the hook, commits from a clone where
# core.hooksPath was never set, and content arriving through a merge. This hook
# inspects what is actually being published.
#
# Same philosophy as pre-commit: hard blocks (exit 1) only where a false
# positive is near-impossible; everything judgement-dependent is a warning,
# because a hook that blocks legitimate work trains you into --no-verify and
# then protects nothing.
#
# Deliberate bypass:  git push --no-verify
set -u

REMOTE_ARG=${1:-origin}
# $2 is the URL git is actually pushing to. With remote.<name>.pushurl or
# url.<x>.pushInsteadOf configured it is NOT the remote's fetch URL — see the
# pushurl divergence check below.
PUSH_URL_ARG=${2:-}
ZERO=0000000000000000000000000000000000000000

# CLAUDE.md / AGENTS.md / .claude/ / docs/ are local-only operating docs. They
# hold prod hosts, container IDs and deploy detail. AGENTS.md is a symlink to
# CLAUDE.md, so publishing either publishes the same content.
FORBIDDEN='^(CLAUDE\.md|AGENTS\.md|\.claude/|docs/)'
# Only the env files that by convention hold real secrets. .env.example and the
# committed Vite .env.development / .env.production are legitimate here.
ENV_HARD='(^|/)\.env$|(^|/)\.env\.local$|(^|/)\.env\..+\.local$'

fail=0

# git invokes this hook with $1 = the remote's configured NAME ("origin"),
# EXCEPT for `git push <url> <branch>`, where there is no name and $1 is the
# URL itself. --remotes=<name> below only matches refs under
# refs/remotes/<name>/*, so a URL argument matches nothing, the "exclude
# already-published commits" step below silently degrades to excluding
# nothing, and a brand-new branch gets its full history scanned — a
# false-positive BLOCK on content that is already public. Resolve the actual
# configured remote name by matching $1 against every remote's URL.
resolve_remote_name() {
  arg=$1
  if git remote get-url "$arg" >/dev/null 2>&1; then
    printf '%s\n' "$arg"
    return 0
  fi
  for r in $(git remote); do
    url=$(git remote get-url "$r" 2>/dev/null) || continue
    if [ "$url" = "$arg" ]; then
      printf '%s\n' "$r"
      return 0
    fi
  done
  return 1
}

REMOTE_NAME=$(resolve_remote_name "$REMOTE_ARG") || REMOTE_NAME=""

# Even with the right name, refs/remotes/<name>/* only reflects the last
# fetch — if it is empty (never fetched, pruned, or manually deleted)
# excluding by it removes nothing and a brand-new branch's full history gets
# scanned again. The tempting fallback, `--not --all`, is actually WORSE: for
# an ordinary push `--all` includes refs/heads/<branch-being-pushed> itself,
# so `git log "$local_sha" --not --all` is *always* empty regardless of
# content — FILES comes back empty, `continue` fires below, and the push
# proceeds completely unchecked. That turns a noisy false-positive BLOCK into
# a silent leak, which is strictly worse in a guard whose entire purpose is
# failing closed.
#
# The unnamed `--not --remotes` is ALSO wrong: it excludes remote-tracking
# refs of EVERY configured remote, not just the one being pushed to. If the
# target remote has no tracking data (the exact condition that triggers this
# fallback: URL push, never fetched, or pruned) while a DIFFERENT remote's
# tracking refs already contain the forbidden commit (e.g. a private mirror
# that was fetched, alongside a public origin that wasn't), that commit gets
# excluded from the scan by the OTHER remote's ref and the push silently
# succeeds — the same fail-open class as `--all`, just with a narrower
# precondition.
#
# There is no ref-set that reliably means "already known to be published on
# THIS remote" once its own tracking data is unusable. So exclude nothing:
# EXCLUDE="" turns `git log "$local_sha" --not $EXCLUDE` into
# `git log "$local_sha" --not` (a trailing --not with nothing after it is a
# no-op to git, not an error), which is a full-history scan of the branch
# being pushed. Noisy — it may BLOCK on content already public on this exact
# remote — but never silently blind to a leak. The BLOCKED message below
# says so honestly when this path is taken.
# Even the NAME being right is not enough. refs/remotes/<name>/* is populated
# by FETCHES from that remote's fetch URL. A remote can push somewhere else
# entirely — `remote.<name>.pushurl`, or `url.<x>.pushInsteadOf` — in which
# case those tracking refs describe a DIFFERENT repository than the one this
# push delivers to. Excluding by them then means "already published over
# there", not "already published here": content long since public on the fetch
# remote is dropped from the scan and sails through to the push target, which
# may be the public repo this guard exists to protect. Same failure class as
# the `--all` and cross-remote holes above.
#
# So narrow only when the push target really is that remote's fetch source.
# `git remote get-url --push` resolves pushurl AND pushInsteadOf (verified on
# git 2.53), and $2 is git's own report of the target, so both are compared
# against the fetch URL and both must agree. Divergence — or several push URLs
# (multi-line output) — de-narrows to the EXCLUDE="" full-history fallback,
# which is noisy but fails closed and says so in its message.
FETCH_URL=$(git remote get-url "$REMOTE_NAME" 2>/dev/null) || FETCH_URL=""
PUSH_URL=$(git remote get-url --push "$REMOTE_NAME" 2>/dev/null) || PUSH_URL=""
same_target=0
if [ -n "$FETCH_URL" ] && [ "$PUSH_URL" = "$FETCH_URL" ]; then
  if [ -z "$PUSH_URL_ARG" ] || [ "$PUSH_URL_ARG" = "$FETCH_URL" ]; then
    same_target=1
  fi
fi

if [ -n "$REMOTE_NAME" ] && [ "$same_target" -eq 1 ] && [ -n "$(git for-each-ref "refs/remotes/$REMOTE_NAME")" ]; then
  EXCLUDE="--remotes=$REMOTE_NAME"
  NARROWED=1
else
  EXCLUDE=""
  NARROWED=0
fi

# Read git's ref lines DIRECTLY from stdin. Piping into this loop would run the
# body in a subshell and every `fail=1` set below would be lost on exit,
# silently turning each hard block into a no-op.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # All-zero local sha = branch deletion. Nothing is published — this branch
  # of the hook is intentionally a no-op and is expected to behave exactly
  # like no hook being installed at all.
  [ "$local_sha" = "$ZERO" ] && continue

  # Decide whether we can trust a precise remote_sha..local_sha range, or
  # must fall back to scanning everything not already known to be published:
  #   - remote_sha is all-zero: brand-new ref, no comparison point at all.
  #   - remote_sha is non-zero but we don't have that commit locally (e.g. a
  #     force-push over history this clone never fetched): `git log
  #     remote_sha..local_sha` would die with "fatal: Invalid revision
  #     range", its exit status would be silently discarded by the command
  #     substitution below, FILES would come back empty, and the hard block
  #     would become a no-op. Fail closed instead: fall back to the same
  #     "not already published" scan used for new branches.
  use_full_range=0
  if [ "$remote_sha" = "$ZERO" ]; then
    use_full_range=1
  elif ! git rev-parse -q --verify "${remote_sha}^{commit}" >/dev/null 2>&1; then
    use_full_range=1
  fi

  if [ "$use_full_range" -eq 1 ]; then
    set -- "$local_sha" --not $EXCLUDE
  else
    set -- "$remote_sha..$local_sha"
  fi

  # -m: also diff merge commits against each parent. Plain --name-only gives
  #     a merge commit no diff at all, so a file introduced only by the merge
  #     itself (an "evil merge" / conflict-resolution addition present on
  #     neither parent) would otherwise be completely invisible.
  # -c core.quotePath=false: with the (default-on) core.quotePath, git prints
  #     non-ASCII paths as a quoted, octal-escaped string, e.g.
  #     "docs/pr\303\274fung.md". The leading quote defeats the `^`/`(^|/)`
  #     anchors in FORBIDDEN/ENV_HARD below and the path slips through.
  # A command substitution silently discards the exit status of what it runs.
  # If this `git log` ever fails, FILES comes back empty, the `continue` below
  # fires, and the push proceeds completely unchecked — the same fail-open
  # shape as the unresolvable-remote_sha bug. Capture the status explicitly
  # (of git log, not of `sort`, hence the temp-free two-step) and fail closed.
  # --diff-filter=d selects every change EXCEPT deletions (lowercase excludes).
  #     The obvious allow-list spelling, ACMR, silently drops T (type change):
  #     replacing a committed AGENTS.md SYMLINK with a real file full of prod
  #     hosts and deploy detail is a pure T, was invisible to the scan, and
  #     landed on the remote with exit 0 — reproduced. An exclude-list also
  #     fails closed against any diff status git may add in future, whereas an
  #     allow-list would silently ignore it. Deletions stay excluded on
  #     purpose: removing docs/x.md is exactly the push this guard wants.
  LOGOUT=$(git -c core.quotePath=false log --format= --name-only --diff-filter=d -m "$@") || {
    echo "BLOCKED ($local_ref): could not inspect this push's commit range — 'git log' failed."
    echo "  Refusing to let an unreadable range pass as 'nothing to see'."
    echo "  If you have confirmed the outgoing commits are clean, override with: git push --no-verify"
    fail=1
    continue
  }
  FILES=$(printf '%s\n' "$LOGOUT" | sort -u)
  [ -n "$FILES" ] || continue

  # ------------------------------------------------------------- HARD BLOCK 1
  HITS=$(printf '%s\n' "$FILES" | grep -E "$FORBIDDEN" || true)
  ENVHITS=$(printf '%s\n' "$FILES" | grep -E "$ENV_HARD" || true)
  if [ -n "$HITS" ] || [ -n "$ENVHITS" ]; then
    if [ "$use_full_range" -eq 1 ] && [ "$NARROWED" -eq 0 ]; then
      # We could not narrow the scan against the remote (no usable tracking
      # data for it), so this is a full-history scan, not a diff of what's
      # actually new. Say so honestly rather than implying certainty we don't
      # have.
      echo "BLOCKED ($local_ref): could not narrow this push's range against the remote (no usable tracking data) — the following paths MAY already be published, but are flagged to be safe:"
    else
      echo "BLOCKED: this push would publish local-only files ($local_ref):"
    fi
    [ -n "$HITS" ] && printf '  %s\n' $HITS
    [ -n "$ENVHITS" ] && printf '  %s\n' $ENVHITS
    echo "  These hold operating detail — prod hosts, container IDs, deploy notes."
    echo "  If you have confirmed they are already public, override with: git push --no-verify"
    fail=1
  fi
done

[ "$fail" -eq 0 ] || exit 1
exit 0
