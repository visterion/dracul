#!/bin/sh
# pre-push — last-moment leak guard for a PUBLIC repo.
#
# pre-commit sees only STAGED files of a SINGLE commit. It is blind to
# --no-verify commits, commits predating the hook, commits from a clone where
# core.hooksPath was never set, and content arriving through a merge. This hook
# inspects what is actually being published.
#
# Same philosophy as pre-commit: hard blocks (exit 1) only where a false
# positive is near-impossible; everything judgement-dependent is a warning,
# because a hook that blocks legitimate work trains you into --no-verify and
# then protects nothing.
#
# Deliberate bypass:  git push --no-verify
set -u

REMOTE_ARG=${1:-origin}
# $2 is the URL git is actually pushing to. With remote.<name>.pushurl or
# url.<x>.pushInsteadOf configured it is NOT the remote's fetch URL — see the
# pushurl divergence check below.
PUSH_URL_ARG=${2:-}
ZERO=0000000000000000000000000000000000000000

# CLAUDE.md / AGENTS.md / .claude/ / docs/ are local-only operating docs. They
# hold prod hosts, container IDs and deploy detail. AGENTS.md is a symlink to
# CLAUDE.md, so publishing either publishes the same content.
#
# CLAUDE.md / AGENTS.md / .claude/ match at ANY depth: Claude Code genuinely
# reads per-directory CLAUDE.md and .claude/, so java-server/CLAUDE.md and
# chronicle/.claude/settings.json are just as local-only as the root ones.
# docs/ stays deliberately ROOT-anchored — a vendored docs/ tree inside a
# subproject is legitimate content, and a hook that blocks legitimate work
# trains the operator into --no-verify and then protects nothing.
FORBIDDEN='(^|/)(CLAUDE\.md|AGENTS\.md|\.claude/)|^docs/'
# Only the env files that by convention hold real secrets. .env.example and the
# committed Vite .env.development / .env.production are legitimate here.
ENV_HARD='(^|/)\.env$|(^|/)\.env\.local$|(^|/)\.env\..+\.local$'

fail=0
# One-shot latch for the CLAUDE.md size WARN at the end of the ref loop.
SIZE_WARNED=0

# git log's path list is captured through a FILE, not a pipeline into a command
# substitution: --name-only -z separates paths with NUL and a command
# substitution silently DROPS NUL bytes (gluing every path into one blob),
# while a pipeline would replace git's exit status with tr's and re-open the
# fail-open closed earlier. If mktemp is unavailable TMPF stays empty, the
# redirection below fails, and the hook blocks — fail closed.
TMPF=$(mktemp 2>/dev/null) || TMPF=""
# Scratch file for the added-lines (content, not paths) extraction used by
# HARD BLOCK 2 and the warnings below. Created once, up front, and overwritten
# per ref-line inside the loop — same fail-closed discipline as TMPF: if mktemp
# is unavailable the variable stays empty, the redirection below fails, and the
# corresponding check blocks instead of silently seeing nothing.
SCANF=$(mktemp 2>/dev/null) || SCANF=""
# Scratch files for the tree audit (WARN 3, below) — overwritten per ref-line
# inside the loop, same fail-closed discipline as TMPF/SCANF: if mktemp is
# unavailable the variable stays empty and the audit prints a WARN that it
# could not run, instead of silently producing an empty (and therefore falsely
# clean-looking) result. SUBF holds the paths this push is already BLOCKING, so
# the audit can subtract them and never describe a just-blocked path as
# "already published".
TREEF=$(mktemp 2>/dev/null) || TREEF=""
SUBF=$(mktemp 2>/dev/null) || SUBF=""
# Created here, BEFORE the trap is installed, not after: the trap's action is
# a single-quoted string re-evaluated at signal time, so it already sees
# whatever ALLOWF holds when it fires — but under `set -u` a signal landing
# in the gap between `trap` and the assignment would dereference an unset
# $ALLOWF and abort with "unbound variable" instead of running the cleanup.
# Seeding it (even before the real mktemp below overwrites it) closes that
# gap.
ALLOWF=""
trap 'rm -f "$TMPF" "$SCANF" "$TREEF" "$SUBF" "$ALLOWF"' EXIT HUP INT TERM

# ---------------------------------------------------------- optional allow-list
# Real email addresses have no rotation path (see CLAUDE.md's "never commit
# personal data") and must live neither in this committed, shared hook nor
# anywhere else in the repo — this repo already leaked a real address once as
# a config default (the DRACUL_DEPOTS_LIVE_VISIBLE_EMAILS incident). So an
# operator who wants to silence the MAILS warning below for their own
# known-safe address needs somewhere local, uncommittable, to put it.
#
# --git-common-dir, NOT --git-dir: in a git WORKTREE, .git is a FILE pointing
# at that worktree's private git-dir; --git-dir would then resolve to a
# per-worktree path, giving every worktree its own, different allow-list. This
# repo runs two worktrees today, so that is not a theoretical distinction.
# --git-common-dir always resolves to the one shared .git directory, so one
# file backs every worktree of this clone. The hook itself is committed and
# shared; this file is local-only and is never staged, added or pushed by
# anything in this repo.
#
# Suppresses ONLY the MAILS warning further below — never HARD BLOCK 1, never
# HARD BLOCK 2, never the INFRA warning. It must not become a general
# skeleton key.
#
# Missing, empty or unreadable: behaves exactly as if empty, i.e. the MAILS
# warning still fires. A read failure must never be the thing that silences a
# warning — "warns one time too many" is the safe direction for a file that,
# by construction, is never itself checked in or reviewed.
#
# Guarantee actually enforced at the point of use, below: a MALFORMED line in
# this file (a bare regex metacharacter like `[`, or one so long it blows the
# argv/exec size limit) must never silence the MAILS warning for the WHOLE
# push. Reproduced against GNU grep 3.12: matching addresses one line at a
# time with `grep -vix "$line"` treats that line as a REGEX and as an argv
# element — a single `[` line makes grep exit 2 with no output, and a
# ~200000-byte line trips E2BIG, and in both cases the old `|| true` swallowed
# the failure and assigned grep's empty stdout back over $MAILS, blanking the
# warning for every real address in the range. The fix used below is
# `grep -Fvix -f "$ALLOWF"`: `-F` makes every line a literal string, not a
# regex (this also closes IMPORTANT 1: an allow-listed address containing a
# literal dot no longer wildcard-matches a DIFFERENT address that merely
# has some other character in that position via the unescaped `.`),
# `-f` reads the pattern list from a FILE so there is no argv/exec limit to
# exceed, and the exit status is inspected (0/1 = ran fine, keep the filtered
# result; anything else = grep itself failed, keep $MAILS UNFILTERED so the
# warning still fires rather than being silently blanked).
ALLOWLIST_FILE="$(git rev-parse --git-common-dir 2>/dev/null)/allowed-emails"
ALLOWF=$(mktemp 2>/dev/null) || ALLOWF=""
if [ -n "$ALLOWF" ] && [ -r "$ALLOWLIST_FILE" ]; then
  LC_ALL=C sed -e 's/#.*//' -e 's/^[ 	]*//' -e 's/[ 	]*$//' "$ALLOWLIST_FILE" 2>/dev/null \
    | LC_ALL=C grep -v '^$' > "$ALLOWF" || : > "$ALLOWF"
fi

# git invokes this hook with $1 = the remote's configured NAME ("origin"),
# EXCEPT for `git push <url> <branch>`, where there is no name and $1 is the
# URL itself. --remotes=<name> below only matches refs under
# refs/remotes/<name>/*, so a URL argument matches nothing, the "exclude
# already-published commits" step below silently degrades to excluding
# nothing, and a brand-new branch gets its full history scanned — a
# false-positive BLOCK on content that is already public. Resolve the actual
# configured remote name by matching $1 against every remote's URL.
resolve_remote_name() {
  arg=$1
  if git remote get-url "$arg" >/dev/null 2>&1; then
    printf '%s\n' "$arg"
    return 0
  fi
  for r in $(git remote); do
    url=$(git remote get-url "$r" 2>/dev/null) || continue
    if [ "$url" = "$arg" ]; then
      printf '%s\n' "$r"
      return 0
    fi
  done
  return 1
}

REMOTE_NAME=$(resolve_remote_name "$REMOTE_ARG") || REMOTE_NAME=""

# Narrowing is only safe when refs/remotes/<name>/* really describes THIS
# push's target, which needs two things beyond a resolvable name:
#   - non-empty tracking data (never fetched / pruned / manually deleted means
#     it proves nothing), and
#   - push URL == fetch URL. Tracking refs are populated by FETCHES; with
#     `remote.<name>.pushurl` or `url.<x>.pushInsteadOf` they describe a
#     DIFFERENT repository than the push delivers to, so excluding by them
#     means "already published over there". `git remote get-url --push`
#     resolves both mechanisms (verified on git 2.53) and $2 is git's own
#     report of the target; both are compared against the fetch URL and both
#     must agree. Several push URLs (multi-line) also count as divergence.
#
# When narrowing is unsafe, exclude NOTHING (EXCLUDE=""). Every tempting
# fallback fails OPEN: `--not --all` includes the branch being pushed, so the
# range is always empty and the push goes unchecked entirely; the unnamed
# `--not --remotes` excludes EVERY remote's tracking refs, so a leak visible
# only via a private mirror is invisible when pushed to the public remote.
# `git log "$local_sha" --not` (trailing --not, a no-op to git) is a
# full-history scan instead: noisy — it may BLOCK on content already public on
# this exact remote — but never blind. The BLOCKED message says so honestly
# when this path is taken.
FETCH_URL=$(git remote get-url "$REMOTE_NAME" 2>/dev/null) || FETCH_URL=""
PUSH_URL=$(git remote get-url --push "$REMOTE_NAME" 2>/dev/null) || PUSH_URL=""
same_target=0
if [ -n "$FETCH_URL" ] && [ "$PUSH_URL" = "$FETCH_URL" ]; then
  if [ -z "$PUSH_URL_ARG" ] || [ "$PUSH_URL_ARG" = "$FETCH_URL" ]; then
    same_target=1
  fi
fi

if [ -n "$REMOTE_NAME" ] && [ "$same_target" -eq 1 ] && [ -n "$(git for-each-ref "refs/remotes/$REMOTE_NAME")" ]; then
  EXCLUDE="--remotes=$REMOTE_NAME"
  NARROWED=1
else
  EXCLUDE=""
  NARROWED=0
fi

# Read git's ref lines DIRECTLY from stdin. Piping into this loop would run the
# body in a subshell and every `fail=1` set below would be lost on exit,
# silently turning each hard block into a no-op.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # All-zero local sha = branch deletion. Nothing is published — this branch
  # of the hook is intentionally a no-op and is expected to behave exactly
  # like no hook being installed at all.
  [ "$local_sha" = "$ZERO" ] && continue

  # Decide whether we can trust a precise remote_sha..local_sha range, or
  # must fall back to scanning everything not already known to be published:
  #   - remote_sha is all-zero: brand-new ref, no comparison point at all.
  #   - remote_sha is non-zero but we don't have that commit locally (e.g. a
  #     force-push over history this clone never fetched): `git log
  #     remote_sha..local_sha` would die with "fatal: Invalid revision
  #     range", its exit status would be silently discarded by the command
  #     substitution below, FILES would come back empty, and the hard block
  #     would become a no-op. Fail closed instead: fall back to the same
  #     "not already published" scan used for new branches.
  use_full_range=0
  if [ "$remote_sha" = "$ZERO" ]; then
    use_full_range=1
  elif ! git rev-parse -q --verify "${remote_sha}^{commit}" >/dev/null 2>&1; then
    use_full_range=1
  fi

  if [ "$use_full_range" -eq 1 ]; then
    set -- "$local_sha" --not $EXCLUDE
  else
    set -- "$remote_sha..$local_sha"
  fi

  # -m: also diff merge commits against each parent. Plain --name-only gives
  #     a merge commit no diff at all, so a file introduced only by the merge
  #     itself (an "evil merge" / conflict-resolution addition present on
  #     neither parent) would otherwise be completely invisible.
  # -c core.quotePath=false: with the (default-on) core.quotePath, git prints
  #     non-ASCII paths as a quoted, octal-escaped string, e.g.
  #     "docs/pr\303\274fung.md". The leading quote defeats the `^`/`(^|/)`
  #     anchors in FORBIDDEN/ENV_HARD below and the path slips through.
  # A command substitution silently discards the exit status of what it runs.
  # If this `git log` ever fails, FILES comes back empty, the `continue` below
  # fires, and the push proceeds completely unchecked — the same fail-open
  # shape as the unresolvable-remote_sha bug. Hence the redirect into $TMPF and
  # the explicit `if ! git ...`: git's own status is tested, never tr's or
  # sort's, and a failure fails closed.
  # --diff-filter=d selects every change EXCEPT deletions (lowercase excludes).
  #     The obvious allow-list spelling, ACMR, silently drops T (type change):
  #     replacing a committed AGENTS.md SYMLINK with a real file full of prod
  #     hosts and deploy detail is a pure T, was invisible to the scan, and
  #     landed on the remote with exit 0 — reproduced. An exclude-list also
  #     fails closed against any diff status git may add in future, whereas an
  #     allow-list would silently ignore it. Deletions stay excluded on
  #     purpose: removing docs/x.md is exactly the push this guard wants.
  # -z: emit paths VERBATIM, NUL-separated. core.quotePath=false only stops git
  #     from quoting high-bit bytes; a path containing a newline, a double
  #     quote, a backslash or a control character is ALWAYS C-quoted, and the
  #     leading `"` defeats the `^` in FORBIDDEN and the `(^|/)` in ENV_HARD.
  #     `docs/leak<newline>two.md` and `docs/qu"ote.md` both pushed at exit 0
  #     and landed in the remote tree — reproduced. With -z there is no quoting
  #     at all. A path with an embedded newline still splits into two lines
  #     after the tr below, but the fragment carrying the forbidden prefix is
  #     the one that starts a record, so it still matches (and any extra
  #     fragment can only cause an extra block — closed, not open).
  if [ -z "$TMPF" ] || ! git -c core.quotePath=false log --format= --name-only --diff-filter=d -m -z "$@" > "$TMPF"; then
    echo "BLOCKED ($local_ref): could not inspect this push's commit range — 'git log' failed."
    echo "  Refusing to let an unreadable range pass as 'nothing to see'."
    echo "  If you have confirmed the outgoing commits are clean, override with: git push --no-verify"
    fail=1
    continue
  fi
  FILES=$(tr '\0' '\n' < "$TMPF" | LC_ALL=C sort -u)
  # No `[ -n "$FILES" ] || continue` here. It read as a harmless fast path but
  # also skipped the whole-tree checks BELOW the range scans: --diff-filter=d
  # excludes deletions, so a deletion-only commit produces an empty FILES and
  # silently disabled both the tree audit and the CLAUDE.md size WARN —
  # reproduced. The range greps below are no-ops on an empty FILES anyway.

  # Whether this range contains a merge commit at all. The four-line "-m can
  # resurface already-public content" caveat attached to the blocks below is
  # only true for merges, and printing it on every single block is exactly the
  # kind of unconditional noise that trains the operator into --no-verify.
  HAS_MERGE=$(git rev-list --merges --max-count=1 "$@" 2>/dev/null) || HAS_MERGE=""

  # ------------------------------------------------------------- HARD BLOCK 1
  # LC_ALL=C on every grep that reads path data. In a UTF-8 locale (the hook
  # inherits the user's LANG) GNU grep classifies input containing an INVALID
  # multibyte sequence as binary: it prints "binary file matches" to stderr and
  # emits NO matching lines. One filename with a stray 0xFF byte therefore
  # blanked HITS for the WHOLE range — disabling every rule at once, not just
  # its own path — and `docs/le\377ak.md` reached the remote at exit 0.
  # Reproduced. The C locale treats bytes as bytes, so nothing is "binary".
  # -i: FORBIDDEN/ENV_HARD match case-INSENSITIVELY. `claude.md` IS `CLAUDE.md`
  # on a case-insensitive filesystem (macOS default), and a case-sensitive
  # grep let `claude.md` and `Docs/runbook.md` push through at exit 0 —
  # reproduced. Accepted trade-off: a legitimately named root `Docs/` would
  # now also block; none exists in this repo.
  HITS=$(printf '%s\n' "$FILES" | LC_ALL=C grep -Ei "$FORBIDDEN" || true)
  ENVHITS=$(printf '%s\n' "$FILES" | LC_ALL=C grep -Ei "$ENV_HARD" || true)
  if [ -n "$HITS" ] || [ -n "$ENVHITS" ]; then
    if [ "$use_full_range" -eq 1 ] && [ "$NARROWED" -eq 0 ]; then
      # We could not narrow the scan against the remote (no usable tracking
      # data for it), so this is a full-history scan, not a diff of what's
      # actually new. Say so honestly rather than implying certainty we don't
      # have.
      echo "BLOCKED ($local_ref): could not narrow this push's range against the remote (no usable tracking data) — the following paths MAY already be published, but are flagged to be safe:"
    else
      echo "BLOCKED: this push would publish local-only files ($local_ref):"
    fi
    # Quoted, one path per line via sed — NOT `printf '  %s\n' $HITS`. Unquoted
    # word-splitting broke `docs/a b.md` into two lines and, worse, subjected
    # every path to pathname expansion: `docs/a b*.md` was reported as whatever
    # happened to match in the CWD, i.e. the block named files that do not
    # exist. Reproduced.
    [ -n "$HITS" ] && printf '%s\n' "$HITS" | sed 's/^/  /'
    [ -n "$ENVHITS" ] && printf '%s\n' "$ENVHITS" | sed 's/^/  /'
    echo "  These hold operating detail — prod hosts, container IDs, deploy notes."
    if [ -n "$HAS_MERGE" ]; then
      echo "  Note: on a merge, a listed path can already be published via the other"
      echo "  parent (git log -m diffs merges against EACH parent independently, so"
      echo "  conflict resolution can resurface already-public content as 'added')."
    fi
    echo "  If you have confirmed they are already public, override with: git push --no-verify"
    fail=1
  fi

  # Added lines of this range — content, not paths, so newline-delimiting is
  # fine, but git log's exit status still must not be discarded (the same
  # fail-open shape as the path scan above: a failed `git log` behind a bare
  # command substitution would leave ADDED_SCAN empty and silently disable
  # HARD BLOCK 2 and the warnings alike). Same flags as the path scan above,
  # and for the same reasons:
  #   -m: a credential introduced only by a MERGE commit (added during
  #       conflict resolution, present on neither parent) gets no diff at all
  #       without it — the identical defect documented above, reproduced here
  #       too: it silenced both HARD BLOCK 2 and the WARNs for the whole
  #       merge-introduced range. Trade-off recorded here because the BLOCKED
  #       message below refers back to it: -m diffs a merge against EACH
  #       parent independently, so content already committed (and already
  #       public) via one parent can appear as "added" relative to the OTHER
  #       parent when conflict resolution keeps it. A block or warning below
  #       may therefore name content that is already on the remote — the
  #       message says so explicitly (only when the range actually contains a
  #       merge), so an operator who has actually checked isn't driven to
  #       --no-verify by what looks like a false leak.
  #   --diff-filter=d (not ACMR): ACMR silently drops T (type change) — a
  #       credential-bearing SYMLINK replaced by a real file carrying the
  #       token is a pure T and was invisible to ACMR, reaching the remote at
  #       exit 0. Deletions stay excluded on purpose.
  #   --text: without it, a file git classifies as binary (a NUL in its
  #       first ~8000 bytes, or a `-diff` gitattribute) gets
  #       "Binary files a/x and b/x differ" instead of a patch, and any
  #       credential inside is never scanned at all.
  #
  # ':(exclude).githooks/' — this hook legitimately contains credential
  # *patterns* (the regex below) and would otherwise block its own push. There
  # used to be a SECOND, unexcluded `git log -p` pass feeding the INFRA/MAILS
  # warnings, which meant this repo's own hook TEST FIXTURES (a synthetic
  # 192.168.x address, a synthetic .invalid mailbox) warned on every push that
  # touched .githooks/ — unavoidable, unsuppressable noise, i.e. exactly the
  # --no-verify training this hook's doctrine exists to avoid. The warnings now
  # read this same excluded stream. Accepted trade-off, decided by the owner: a
  # real address pasted into a hook COMMENT no longer warns at push time —
  # pre-commit still catches it at commit time, and the same exclusion already
  # applied to credentials. Dropping the second pass also removes a full
  # duplicate `git log -p` (tens of MB of patch on the full-history fallback)
  # per pushed ref.
  # PATH rules (HARD BLOCK 1 and the tree audit) are NOT narrowed — they still
  # apply to .githooks/ like anywhere else.
  if [ -z "$SCANF" ] || ! git log --format= -U0 --diff-filter=d -m --text -p "$@" -- . ':(exclude).githooks/' > "$SCANF"; then
    echo "BLOCKED ($local_ref): could not inspect this push's added content — 'git log' failed."
    echo "  Refusing to let an unreadable range pass as 'nothing to see'."
    echo "  If you have confirmed the outgoing commits are clean, override with: git push --no-verify"
    fail=1
    continue
  fi
  # grep -a: without it, a NUL byte ANYWHERE in the diff — not necessarily in
  # the leaking file itself — makes grep classify the whole diff stream as
  # binary, print "binary file matches" to stderr, and emit NO lines. That
  # silently disables every content check for the whole ref, the identical
  # "one bad byte blanks every rule at once" shape LC_ALL=C fixes for invalid
  # UTF-8 above — but LC_ALL=C does NOT cover a literal NUL byte, only -a
  # does. -a is a GNU grep extension; this hook assumes GNU grep (the push
  # host is Linux) — a future BSD/macOS port must re-check it.
  ADDED_SCAN=$(LC_ALL=C grep -a '^+' "$SCANF" | LC_ALL=C grep -a -v '^+++' || true)

  # ------------------------------------------------------------- HARD BLOCK 2
  # Deliberately narrow — no generic 'password=' / 'secret', those hit
  # legitimate config work and turn the hook into noise.
  CRED=$(printf '%s\n' "$ADDED_SCAN" | LC_ALL=C grep -E \
    'sk-ant-|sk-proj-|ghp_|gho_|ghs_|github_pat_|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|xox[baprs]-|hf_[A-Za-z0-9]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(postgres|postgresql|mysql|mongodb\+srv|redis|amqp)://[^/: ]+:[^@ ]+@' \
    || true)
  if [ -n "$CRED" ]; then
    echo "BLOCKED: outgoing commits contain what looks like a real credential ($local_ref)."
    echo "  Rotate it FIRST — a history rewrite does NOT delete it from GitHub."
    echo "  Move the value to an env var with an EMPTY default."
    if [ -n "$HAS_MERGE" ]; then
      echo "  Note: on a merge, this text can already be published via the other"
      echo "  parent (git log -m diffs merges against EACH parent independently)."
    fi
    fail=1
  fi

  # ---------------------------------------------------------------- WARN ONLY
  INFRA=$(printf '%s\n' "$ADDED_SCAN" | LC_ALL=C grep -E \
    '192\.168\.|10\.[0-9]+\.[0-9]+\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.|\.fritz\.box|\bpve\b|(CT|LXC) ?1[0-9][0-9]\b' \
    || true)
  if [ -n "$INFRA" ]; then
    echo "WARN: outgoing commits mention internal infrastructure."
    echo "      Prefer 192.0.2.x / example.com / \"the container\"."
  fi

  MAILS=$(printf '%s\n' "$ADDED_SCAN" \
    | LC_ALL=C grep -oE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' \
    | LC_ALL=C grep -vE '@(example\.(com|org|net)|users\.noreply\.github\.com)$' || true)
  # Optional local allow-list (see ALLOWF above): suppresses ONLY this warning,
  # never HARD BLOCK 1/2, never INFRA. -s: an absent, empty or unreadable
  # ALLOWF (mktemp failure, no ALLOWLIST_FILE, or a read that fell through to
  # the `: > "$ALLOWF"` fallback above) leaves it empty, so this branch is
  # skipped and MAILS is reported exactly as if no allow-list existed at all.
  #
  # -F: match every allow-list line as a LITERAL string, not a regex — a bare
  #     `[` no longer makes grep exit 2, and a `.` in an address no longer
  #     wildcards onto a different local-part that merely has some other
  #     character where the allow-listed address had a dot.
  # -f "$ALLOWF": read the whole pattern list from a FILE in one grep call,
  #     not one call per line — no argv/exec length limit to blow on an
  #     over-long line, and no per-line `|| true` to swallow a per-call
  #     failure and quietly blank $MAILS.
  # rc guard: 0 = matches found and filtered, 1 = ran fine with nothing left
  #     (both mean FILTERED is trustworthy); anything else means grep itself
  #     failed and FILTERED is not a filtered result, it is garbage — keep the
  #     original, unfiltered $MAILS so the warning still fires rather than
  #     silently disappearing.
  if [ -n "$MAILS" ] && [ -s "$ALLOWF" ]; then
    FILTERED=$(printf '%s\n' "$MAILS" | LC_ALL=C grep -Fvix -f "$ALLOWF")
    rc=$?
    [ "$rc" -le 1 ] && MAILS=$FILTERED
  fi
  if [ -n "$MAILS" ]; then
    echo "WARN: outgoing commits contain non-example email addresses:"
    printf '%s\n' "$MAILS" | LC_ALL=C sort -u | sed 's/^/      /'
    echo "      Personal data has no rotation path. Use owner@example.com."
    echo "      Suppress a known-safe address locally in"
    echo "      $ALLOWLIST_FILE (one per line, never committed)."
  fi

  # ------------------------------------------------------- WARN: tree audit
  # The only check that can surface leaks already on the remote: a
  # pre-existing leak predates the hook, so it appears in no future commit
  # range and every scan above — all of which read a RANGE, not the tree — is
  # structurally blind to it. Warning, never a block: a pre-existing state
  # must not permanently prevent pushing anything new.
  #
  # It reads the tree at $remote_sha — what the remote ALREADY has — not at
  # $local_sha. $local_sha's tree includes the commits being pushed right now,
  # so on a blocked push this audit printed "already published, not blocking"
  # about the very path the block above had just refused to publish: untrue,
  # and it directly undercuts the block. Reading $remote_sha means "leaks that
  # already exist on the remote", which is what the check is for, and it is
  # silent unless such a leak GREW.
  # Belt and braces on top of that: subtract the paths this push is blocking
  # ($HITS/$ENVHITS), so even a path that is BOTH pre-existing and re-touched
  # by this push is never described as merely published.
  # When there is no usable $remote_sha (new branch, or a remote_sha this clone
  # does not have — the use_full_range path) the audit is SKIPPED. Falling back
  # to $local_sha is what produced the untrue message; having no baseline means
  # there is nothing meaningful to report, not a licence to report the wrong
  # thing.
  # This reads a full tree, not a diff, so -m (merge-vs-parent diffing) does
  # not apply here — a path introduced only by a historical merge is still an
  # ordinary entry of the tree and is seen like any other.
  if [ "$use_full_range" -eq 0 ]; then
    if [ -z "$TREEF" ] || ! git -c core.quotePath=false ls-tree -r -z --name-only "$remote_sha" > "$TREEF"; then
      echo "WARN: could not audit the remote's tracked tree for pre-existing local-only paths ($local_ref) — 'git ls-tree' failed."
    else
      # LC_ALL=C, -i: same invalid-UTF-8-blanks-the-whole-scan and
      # case-insensitive-filesystem reasons as HITS/ENVHITS above. Both
      # FORBIDDEN and ENV_HARD: applying only FORBIDDEN meant a pre-existing
      # tracked .env — the single worst thing to find already published — was
      # the one class this audit never surfaced. No -a: these are NUL-split
      # PATHS (tr already turned the NUL separators into newlines), not diff
      # content, so no embedded NUL can appear mid-record.
      TREE=$(tr '\0' '\n' < "$TREEF" | LC_ALL=C grep -Ei "$FORBIDDEN|$ENV_HARD" || true)
      # Subtract the paths already reported by HARD BLOCK 1. -F -x: exact,
      # literal whole-line match — these are byte-identical path strings from
      # the same repository, never patterns. rc guard as in the MAILS
      # allow-list: 0/1 mean the filter ran, anything else means grep itself
      # failed and its output is garbage, so keep the UNFILTERED list (warning
      # one time too many is the safe direction).
      if [ -n "$TREE" ] && [ -n "$SUBF" ] && { [ -n "$HITS" ] || [ -n "$ENVHITS" ]; }; then
        printf '%s\n%s\n' "$HITS" "$ENVHITS" | LC_ALL=C grep -v '^$' > "$SUBF" || : > "$SUBF"
        if [ -s "$SUBF" ]; then
          FILTERED=$(printf '%s\n' "$TREE" | LC_ALL=C grep -Fvx -f "$SUBF")
          rc=$?
          [ "$rc" -le 1 ] && TREE=$FILTERED
        fi
      fi
      if [ -n "$TREE" ]; then
        echo "WARN: local-only paths are ALREADY published on the remote ($remote_ref):"
        printf '%s\n' "$TREE" | head -20 | sed 's/^/      /'
        echo "      This push does not add them and is not blocked — but they must not grow,"
        echo "      and removing them from the remote needs more than a history rewrite."
      fi
    fi
  fi

  # ------------------------------------------------------- WARN: CLAUDE.md size
  # Budget recorded as a hard rule inside CLAUDE.md ("Documentation
  # maintenance"): 20480 bytes (20 KB). Not the original 12 KB — CLAUDE.md sits
  # near 20 KB in normal operation, so that budget fired on every single push
  # and trained exactly the --no-verify reflex this hook's own doctrine warns
  # against.
  #
  # It lives INSIDE the ref loop, not after `done`, only so that it is reached
  # exactly when something is actually being published: the loop's ZERO check
  # skips branch deletions with a bare `continue`, and that path is documented
  # to behave exactly like no hook installed — a size WARN on
  # `git push origin :branch` would be a signal about a push that published
  # nothing. The other `continue`s above (a failed `git log`) skip it too, but
  # those already printed a BLOCKED line, so a suppressed WARN is not the
  # notable thing about that push.
  # SIZE_WARNED makes it fire at most ONCE per hook invocation: the file on
  # disk is the same file for every ref line, so a push of three refs printed
  # the identical two lines three times.
  if [ "$SIZE_WARNED" -eq 0 ] && [ -f CLAUDE.md ]; then
    SIZE=$(wc -c < CLAUDE.md)
    if [ "$SIZE" -gt 20480 ]; then
      SIZE_WARNED=1
      echo "WARN: CLAUDE.md is ${SIZE} bytes, over the 20 KB budget."
      echo "      Compress prose or move an over-long index entry into the file it points at."
    fi
  fi
done

[ "$fail" -eq 0 ] || exit 1
exit 0
